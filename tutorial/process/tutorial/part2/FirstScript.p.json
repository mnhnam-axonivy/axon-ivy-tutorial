{
  "$schema" : "https://json-schema.axonivy.com/14.0/project/process.json",
  "id" : "19F4A2C1B0D3E524",
  "config" : {
    "data" : "tutorial.part2.FirstScriptData"
  },
  "elements" : [
    {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "Say hello",
      "config" : {
        "signature" : "sayHello",
        "input" : {
          "params" : [
            {
              "name" : "name",
              "type" : "String",
              "desc" : "The name to greet"
            }
          ],
          "map" : {
            "out.name" : "param.name"
          }
        },
        "request" : {
          "name" : "2.4 Say hello"
        }
      },
      "visual" : {
        "at" : {
          "x" : 96,
          "y" : 64
        }
      },
      "connect" : [
        {
          "id" : "f2",
          "to" : "f3"
        }
      ]
    },
    {
      "id" : "f3",
      "type" : "Script",
      "name" : "Build the greeting",
      "config" : {
        "output" : {
          "map" : {
            "out" : "in",
            "out.greeting" : "\"Hello \" + in.name"
          },
          "code" : "ivy.log.info(out.greeting);"
        }
      },
      "visual" : {
        "at" : {
          "x" : 256,
          "y" : 64
        }
      },
      "connect" : [
        {
          "id" : "f4",
          "to" : "f1"
        }
      ]
    },
    {
      "id" : "f1",
      "type" : "TaskEnd",
      "visual" : {
        "at" : {
          "x" : 416,
          "y" : 64
        }
      }
    }
  ],
  "description" : "Guide 2.4: one Script Step that changes a value and writes it to the log."
}

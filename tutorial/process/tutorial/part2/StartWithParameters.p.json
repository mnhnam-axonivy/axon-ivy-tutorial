          "map" : {
            "out.room" : "param.room",
            "out.people" : "param.people"
          }
        },
        "request" : {
          "name" : "2.3 Book a meeting room"
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 },

{
  "$schema" : "https://json-schema.axonivy.com/14.0/project/process.json",
  "id" : "19F4A2C1B0D3E533",
  "config" : {
    "data" : "tutorial.part3.MappingThenCodeData"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "Calculate a discount",
      "config" : {
        "signature" : "discount",
        "input" : {
          "params" : [
            { "name" : "customer", "type" : "String", "desc" : "Who orders" },
            { "name" : "total", "type" : "Number", "desc" : "Value of the order" }
          ],
          "map" : {
            "out.customer" : "param.customer",
            "out.total" : "param.total"
          }
        },
        "request" : {
          "name" : "3.3 Mapping first, then code"
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 }
      },
      "connect" : [
        { "id" : "f2", "to" : "f3" }
      ]
    }, {
      "id" : "f3",
      "type" : "Script",
      "name" : "Apply the discount",
      "config" : {
        "output" : {
          "map" : {
            "out" : "in",
            "out.discount" : "5",
            "out.level" : "\"standard\""
          },
          "code" : [
            "if (in.total > 1000) {",
            "  out.discount = 10;",
            "  out.level = \"gold\";",
            "}"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 256, "y" : 64 },
        "description" : "Guide 3.3: the mapping sets the usual values, the code changes them for large orders."
      },
      "connect" : [
        { "id" : "f4", "to" : "f1" }
      ]
    }, {
      "id" : "f1",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 416, "y" : 64 }
      }
    } ]
}

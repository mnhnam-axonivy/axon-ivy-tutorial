{
  "name": "axon-ivy-guide-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Builds the offline walkthroughs and the page script of the Axon Ivy Guide in the tutorial project.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check": "node build.mjs --check",
    "preview": "node preview/server.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "smoke": "node tools/smoke.mjs",
    "labels": "node tools/extract-designer-labels.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer-core": "25.17.0"
  }
}
